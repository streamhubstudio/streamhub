# Variables del agente de nodo (stream02 / stream03).
# Copiar a deploy/observability/cluster/.env.node EN EL NODO y completar.
# (`**/.env*`... ojo: el patrón raíz ignora `.env`; este archivo `.env.node`
#  queda cubierto por el .gitignore de este directorio — ver cluster/.gitignore.)
#
# Uso en el nodo:
#   docker compose -f node-agent-compose.yml --env-file .env.node up -d

# Nombre del nodo — DEBE ser stream02 o stream03 (define el label `node` de
# TODAS las métricas de host y logs del nodo). Sin default.
NODE_NAME=stream02

# URL de push a Loki del master. Recomendado: vía nginx del master (TLS +
# allowlist de IPs de nodo — ver cluster/nginx-loki-push.conf). Reemplazá el
# FQDN por el dominio real del master (stream01).
MASTER_LOKI_PUSH_URL=https://stream01.example.com/loki/api/v1/push

# Alternativa directa (cleartext, requiere `ufw allow from <IP-del-nodo> to
# any port 3100` en el master y Loki bindeado a una IP alcanzable):
# MASTER_LOKI_PUSH_URL=http://203.0.113.10:3100/loki/api/v1/push
