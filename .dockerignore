# Keep the build context lean and reproducible: never ship host node_modules,
# prior builds, secrets, or data into the image.
**/node_modules
**/dist
**/__pycache__
**/.pytest_cache
**/.env
**/.env.local
.git
data/
**/data/*.db
**/*.log
**/recordings/
**/*.mp4
legacy/
# Go core: local build outputs never enter the context (the image compiles its own)
streamhub-core-go/bin/
streamhub-core-go/streamhub
streamhub-core-go/logs/
streamhub-core-go/sdk/
