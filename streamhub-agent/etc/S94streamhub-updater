#!/bin/sh
#
# S94streamhub-updater — Init script for streamhub-updater
# Starts BEFORE S95streamhub (agent), so the watchdog is ready.
# Install to: /etc/init.d/S94streamhub-updater
#

DAEMON=/userdata/streamhub/streamhub-updater
CONFIG=/userdata/streamhub/config.yml
SECRETS=/userdata/streamhub/secrets.ini
PIDFILE=/var/run/streamhub-updater.pid
LOGFILE=/tmp/updater.log
LOG_MAX_SIZE=262144  # 256KB
RESPAWN_DELAY=10

rotate_log() {
    if [ -f "$LOGFILE" ]; then
        SIZE=$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt "$LOG_MAX_SIZE" ]; then
            tail -100 "$LOGFILE" > "${LOGFILE}.tmp" 2>/dev/null
            mv -f "${LOGFILE}.tmp" "$LOGFILE" 2>/dev/null
        fi
    fi
}

start() {
    printf "Starting streamhub-updater: "
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "already running (pid $(cat "$PIDFILE"))"
        return 0
    fi

    # Kill any orphaned updater processes
    killall -q streamhub-updater 2>/dev/null
    sleep 1

    # Truncate log before fresh start
    > "$LOGFILE"

    # Respawn loop
    (
        while true; do
            rotate_log
            "$DAEMON" "$CONFIG" "$SECRETS" >> "$LOGFILE" 2>&1
            EXIT_CODE=$?
            [ ! -f "$PIDFILE" ] && break
            rotate_log
            echo "$(date) [respawn] updater exited with code $EXIT_CODE, restarting in ${RESPAWN_DELAY}s..." >> "$LOGFILE"
            sleep "$RESPAWN_DELAY"
        done
    ) &
    echo "$!" > "$PIDFILE"
    echo "OK (pid $!)"
}

stop() {
    printf "Stopping streamhub-updater: "
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        rm -f "$PIDFILE"
        kill -- -"$PID" 2>/dev/null || kill "$PID" 2>/dev/null
        killall -q streamhub-updater 2>/dev/null
        sleep 1
        killall -q -9 streamhub-updater 2>/dev/null
        echo "OK"
    else
        killall -q streamhub-updater 2>/dev/null
        echo "OK (no pidfile)"
    fi
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "streamhub-updater is running (pid $(cat "$PIDFILE"))"
        ps | grep streamhub-updater | grep -v grep
    else
        echo "streamhub-updater is not running"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) restart ;;
    status)  status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
