/* streamhub-agent resource file (Windows) */
#include <winver.h>

1 ICON "res/streamhub.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,11,0,0
    PRODUCTVERSION 1,11,0,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "StreamHub"
            VALUE "FileDescription",  "StreamHub Edge Agent"
            VALUE "FileVersion",      "1.11.0"
            VALUE "InternalName",     "streamhub-agent"
            VALUE "LegalCopyright",   "Copyright (C) 2026 StreamHub"
            VALUE "OriginalFilename", "streamhub-agent.exe"
            VALUE "ProductName",      "StreamHub Agent"
            VALUE "ProductVersion",   "1.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
