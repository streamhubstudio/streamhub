{
  "module": "tags",
  "description": "Per-app dynamic tags CRUD + stream/room tagging (tags.controller.ts, stream-tags.controller.ts).",
  "defaults": {
    "compareHeaders": [
      "content-type"
    ]
  },
  "cases": [
    {
      "name": "tag-login-editor",
      "note": "fresh session: auth.json revokes the fixture sessions when the whole corpus runs",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{editorEmail}}",
        "password": "{{editorPass}}"
      },
      "expectStatus": 200,
      "capture": {
        "tagEditorJwt": "data.token"
      }
    },
    {
      "name": "tag-login-viewer",
      "note": "fresh session",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{viewerEmail}}",
        "password": "{{viewerPass}}"
      },
      "expectStatus": 200,
      "capture": {
        "tagViewerJwt": "data.token"
      }
    },
    {
      "name": "tags-list-empty",
      "method": "GET",
      "path": "/api/v1/apps/live/tags",
      "auth": "globalToken"
    },
    {
      "name": "tags-create-ordered-config",
      "method": "POST",
      "path": "/api/v1/apps/live/tags",
      "auth": "globalToken",
      "rawBody": "{\"slug\":\"store-a\",\"label\":\"  Store A  \",\"kind\":\"store\",\"config_json\":{\"b\":1,\"2\":\"x\",\"10\":true,\"a\":{\"z\":1.50,\"y\":[1e2,-0.0,\"<&>\"]},\"b\":2},\"extra\":1}",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
