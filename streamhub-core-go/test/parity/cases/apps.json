      "body": {
        "yaml": "# hand-edited by an operator\nnotifications:\n  email: ops@example.com\n  on: [stream_started, 'yes']\nname: par-one\ndisplay_name: Hand Edited\ns3:\n  key: inline-key\n  bucket: my-bucket\nmqtt:\n  password: nope\n  events: []\n  qos: 7\nsmtp:\n  pass: nope\n  port: 70000\ntimezone: ' Mars/Olympus '\nrecording:\n  split_minutes: '15'\n  retention_days: 31\nwebrtc:\n  layers: []\n  transcode_max_height: 1440\n  extra: dropped\nrtmp:\n  transcode: false\nfeatures:\n  chat: true\n  linear:\n    dvr: true\n    dvr_window_seconds: -5\n  drm:\n    enabled: true\n    systems: [FairPlay, bogus, fairplay]\n    scheme: CENC\ntranscoding:\n  encoding: H264+VP8\n  vod_renditions:\n    - {height: 720, bitrate_kbps: 2800}\n    - {height: 100, bitrate_kbps: 1}\n    - {height: 1080.7, bitrate_kbps: '5000'}\n    - {height: 720, bitrate_kbps: 1}\nquotas:\n  max_concurrent_streams: 3\n  max_viewers_per_stream: 0\nlatency_alert:\n  threshold_ms: 0\n  interval_seconds: 1\nvariables:\n  b: 1\n  '10': ten\n  a: true\nreleased: 2024-01-02\n'1': one\nzeta: {nested: [1, {x: y}]}\nlong: \"word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word\"\nmulti: |\n  line one\n  line two\n"
