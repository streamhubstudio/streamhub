{
  "module": "apps",
  "description": "App registry (apps.controller.ts, 22 routes) + admin restart gate: CRUD with tenant scoping and RBAC denials, config.yaml YAML parity (Node js-yaml dump vs Go), PATCH mapping/validation, raw editor + dry-run + backups/revert/reload, presets, masked S3/MQTT/SMTP blocks. Every app created here is deleted at the end (the file runs before auth.json).",
  "defaults": {
    "compareHeaders": [
      "content-type",
      "cache-control"
    ]
  },
  "cases": [
    {
      "name": "apps-list-no-auth",
      "method": "GET",
      "path": "/api/v1/apps",
      "expectStatus": 401
    },
    {
      "name": "apps-list-global",
      "method": "GET",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "expectStatus": 200
    },
    {
      "name": "apps-list-admin",
      "method": "GET",
      "path": "/api/v1/apps",
      "auth": "adminJwt",
      "expectStatus": 200
    },
    {
      "name": "apps-list-owner-empty",
      "method": "GET",
      "path": "/api/v1/apps",
      "auth": "ownerJwt",
      "expectStatus": 200,
      "note": "owner tenant has no apps yet"
    },
    {
      "name": "apps-list-viewer",
      "method": "GET",
      "path": "/api/v1/apps",
      "auth": "viewerJwt",
      "expectStatus": 200
    },
    {
      "name": "apps-list-app-token",
      "method": "GET",
      "path": "/api/v1/apps",
      "auth": "appToken",
      "expectStatus": 200,
      "note": "app-scoped token: tenant-filtered view"
    },
    {
      "name": "apps-create-invalid-slug",
      "method": "POST",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "body": {
        "name": "Bad Name!"
      },
      "expectStatus": 400
    },
    {
      "name": "apps-create-wrong-types",
      "method": "POST",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "body": {
        "name": 5,
        "displayName": 3,
        "roomPrefix": [
          "x"
        ]
      },
      "expectStatus": 400
    },
    {
      "name": "apps-create-empty-body",
      "method": "POST",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "body": {},
      "expectStatus": 400
    },
    {
      "name": "apps-create-no-body",
      "method": "POST",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "expectStatus": 400,
      "note": "a missing body validates as {}"
    },
    {
      "name": "raw-put-no-body",
      "method": "PUT",
      "path": "/api/v1/apps/live/config/raw",
      "auth": "globalToken",
      "expectStatus": 400
    },
    {
      "name": "apps-create-too-long-display",
      "method": "POST",
      "path": "/api/v1/apps",
      "auth": "globalToken",
      "body": {
        "name": "par-x",
        "displayName": "ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "roomPrefix": "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"
      },
      "expectStatus": 400
    },
    {
      "name": "apps-create-viewer-denied",
