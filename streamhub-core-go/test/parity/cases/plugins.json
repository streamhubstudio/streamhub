{
  "module": "plugins",
  "description": "Plugin framework: marketplace list/get (in-tree + vendored catalog), install/patch/remove + config validation, public overlays, live-data/event channels (token gate), worker hook error paths (no worker is ever spawned), logs, export guards, per-app version pin/rollback, appstore superadmin routes (multipart guards, bundle download) and the grid agent's cluster-token gate. Installs are removed at the end.",
  "defaults": {
    "compareHeaders": [
      "content-type",
      "cache-control"
    ]
  },
  "cases": [
    {
      "name": "list-no-auth",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins",
      "expectStatus": 401
    },
    {
      "name": "list-global",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins",
      "auth": "globalToken",
      "expectStatus": 200
    },
    {
      "name": "list-viewer",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins",
      "auth": "viewerJwt",
      "expectStatus": 403,
      "note": "viewer outside the platform tenant"
    },
    {
      "name": "list-app-token",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins",
      "auth": "appToken",
      "expectStatus": 200
    },
    {
      "name": "list-scoped",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins?stream=nope&room=lobby",
      "auth": "globalToken",
      "expectStatus": 200
    },
    {
