      "note": "tar bytes locked by Go tests (gzip framing differs)"
    },
    {
      "name": "versions-lpr",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/lpr/versions",
      "auth": "globalToken",
      "expectStatus": 200,
      "capture": {
        "lprBuiltin": "data.available.builtinVersion",
        "lprBundleSha": "data.available.versions.0.sha256"
      },
      "mask": [
        "data.available.versions.*.bundleBytes"
      ],
      "note": "gzip bytes are irreproducible across runtimes (planning/GO-DIVERGENCES.md: plugins export): the size is masked and the sha256 is pinned by consistency — captured here, every later occurrence must equal it"
    },
    {
      "name": "versions-not-installed",
