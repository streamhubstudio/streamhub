      },
      "expectStatus": 201,
      "capture": {
        "newTokenId": "id",
        "newToken": "token"
      }
    },
    {
      "name": "tokens-create-app",
      "method": "POST",
      "path": "/api/v1/tokens",
      "auth": "globalToken",
      "body": {
        "name": "parity-run-app",
        "scope": "app",
        "appId": "{{liveAppId}}"
      },
      "expectStatus": 201,
      "capture": {
        "newAppTokenId": "id"
      }
    },
