      "body": {
        "email": "newbie@parity.test",
        "password": "newbie-pass-123"
      },
      "expectStatus": 403
    },
    {
      "name": "signup-existing-user",
      "method": "POST",
      "path": "/api/v1/auth/signup",
      "body": {
        "email": "{{ownerEmail}}",
        "password": "another-pass-123"
      },
      "expectStatus": 403
    },
    {
      "name": "signup-validation",
      "method": "POST",
      "path": "/api/v1/auth/signup",
      "body": {
        "email": "not-an-email",
        "password": "x"
      },
      "expectStatus": 400
    },
    {
      "name": "signup-admin-email",
      "method": "POST",
      "path": "/api/v1/auth/signup",
      "body": {
        "email": "{{adminUser}}",
        "password": "another-pass-123"
      },
      "expectStatus": 400
    },
    {
      "name": "magic-link-unknown-email",
