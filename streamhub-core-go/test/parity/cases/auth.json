{
  "module": "auth",
  "description": "Auth plane: login/signup/magic, guard failures, sk_ tokens CRUD, sessions, account, teams/invites (owner/editor/viewer), tenants+quotas, network security (ip-rules/bans), admin gate, audit trail. Cases run in order; later cases depend on earlier captures and state.",
  "defaults": {
    "compareHeaders": [
      "content-type",
      "cache-control",
      "ratelimit",
      "ratelimit-policy"
    ]
  },
  "cases": [
    {
      "name": "auth-config",
      "method": "GET",
      "path": "/api/v1/auth/config",
      "expectStatus": 200
    },
    {
      "name": "login-admin-ok",
      "note": "first rate-limited request: RateLimit remaining=49",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{adminUser}}",
        "password": "{{adminPass}}"
      },
      "expectStatus": 200,
      "capture": {
        "adminJwt2": "data.token"
      }
    },
    {
      "name": "login-admin-bad-password",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{adminUser}}",
        "password": "nope"
      },
      "expectStatus": 401
    },
    {
      "name": "login-unknown-user",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "ghost@parity.test",
        "password": "whatever-123"
      },
      "expectStatus": 401
    },
    {
      "name": "login-owner-wrong-password",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{ownerEmail}}",
        "password": "wrong-pass-123"
      },
      "expectStatus": 401
    },
    {
      "name": "login-owner-ok",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{ownerEmail}}",
        "password": "{{ownerPass}}"
      },
      "expectStatus": 200,
      "capture": {
        "ownerJwt2": "data.token"
      }
    },
    {
      "name": "login-owner-email-case-insensitive",
      "note": "email is lower-cased before lookup",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "OWNER@Parity.Test",
        "password": "{{ownerPass}}"
      },
      "expectStatus": 200,
      "capture": {
        "ownerJwt3": "data.token"
      }
    },
    {
      "name": "login-viewer-ok",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": "{{viewerEmail}}",
        "password": "{{viewerPass}}"
      },
      "expectStatus": 200
    },
    {
      "name": "login-empty-body",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {},
      "expectStatus": 400
    },
    {
      "name": "login-wrong-types",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "body": {
        "user": 123,
        "password": [
          "x"
        ]
      },
      "expectStatus": 400
    },
    {
      "name": "login-malformed-json",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "headers": {
        "Content-Type": "application/json"
      },
      "rawBody": "{\"user\": \"admin\", ",
      "expectStatus": 404
    },
    {
      "name": "login-get-method",
      "method": "GET",
      "path": "/api/v1/auth/login",
      "expectStatus": 404
    },
    {
      "name": "signup-disabled-new-email",
      "method": "POST",
