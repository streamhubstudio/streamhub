    {
      "name": "import-ok",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/import",
      "auth": "adminJwt",
      "capture": {
        "wfImp": "data.id"
      },
      "rawBody": "{\"workflow\": {\"streamflow\": 1, \"name\": \" Imported \", \"graph\": {\"boxes\": [{\"id\": \"t\", \"type\": \"trigger.manual\", \"config\": {}, \"x\": 10.5, \"y\": 2}, {\"id\": \"c\", \"type\": \"logic.condition\", \"config\": {\"match\": \"all\", \"rules\": [{\"field\": \"trigger.n\", \"op\": \"gt\", \"value\": \"1e1\"}]}}, {\"id\": \"h\", \"type\": \"action.http\", \"config\": {\"url\": \"https://example.com/hook\", \"apiKey\": \"sk-abcdefghijklmnop\", \"token\": \"\\u007b\\u007bsecret.TOKEN}}\", \"password\": \"hunter2\"}}], \"edges\": [{\"from\": \"t\", \"to\": \"c\"}, {\"from\": \"c\", \"fromPort\": \"true\", \"to\": \"h\"}], \"zoom\": 1.25}, \"junk\": 1}}",
      "headers": {
        "Content-Type": "application/json"
      },
      "expectStatus": 201
    },
    {
      "name": "import-name-override",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/import",
      "auth": "adminJwt",
      "rawBody": "{\"workflow\": {\"graph\": {\"boxes\": [{\"id\": \"t\", \"type\": \"trigger.manual\", \"config\": {}, \"x\": 10.5, \"y\": 2}, {\"id\": \"c\", \"type\": \"logic.condition\", \"config\": {\"match\": \"all\", \"rules\": [{\"field\": \"trigger.n\", \"op\": \"gt\", \"value\": \"1e1\"}]}}, {\"id\": \"h\", \"type\": \"action.http\", \"config\": {\"url\": \"https://example.com/hook\", \"apiKey\": \"sk-abcdefghijklmnop\", \"token\": \"\\u007b\\u007bsecret.TOKEN}}\", \"password\": \"hunter2\"}}], \"edges\": [{\"from\": \"t\", \"to\": \"c\"}, {\"from\": \"c\", \"fromPort\": \"true\", \"to\": \"h\"}], \"zoom\": 1.25}}, \"name\": \"  Over  \"}",
      "headers": {
        "Content-Type": "application/json"
      },
      "expectStatus": 201
    },
    {
      "name": "import-default-name",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/import",
