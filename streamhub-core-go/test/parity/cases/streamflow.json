{
  "module": "streamflow",
  "description": "Streamflow plugin API (/apps/:app/plugins/streamflow). Manual-run execution is covered by unit tests (the run outcome depends on the queue: BullMQ+dead Redis in Node vs the in-process runner in Go).",
  "defaults": {
    "compareHeaders": [
      "content-type"
    ]
  },
  "cases": [
    {
      "name": "boxes",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/boxes",
      "auth": "adminJwt",
      "expectStatus": 200
    },
    {
      "name": "events",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/events",
      "auth": "adminJwt",
      "expectStatus": 404,
      "skip": "GO-DIVERGENCE (Node bug fixed in Go): Node's VisionAppsController apps/:app/plugins/:model/events shadows StreamflowController_events (404 'unknown vision model'), so the trigger picker never gets the event catalogue; Go serves it (TestEventsRouteNotShadowed)."
    },
    {
      "name": "boxes-no-auth",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/boxes",
      "expectStatus": 401
    },
    {
      "name": "boxes-viewer-cross-tenant",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/boxes",
      "auth": "viewerJwt",
      "expectStatus": 403
    },
    {
      "name": "boxes-app-token",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/boxes",
      "auth": "appToken",
      "expectStatus": 200
    },
    {
      "name": "workflows-empty",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "expectStatus": 200
    },
    {
      "name": "workflows-unknown-app",
      "method": "GET",
      "path": "/api/v1/apps/no-such-sf-app/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "expectStatus": 404
    },
    {
      "name": "create-no-body",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "expectStatus": 400
    },
    {
      "name": "create-blank-name",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "body": {
        "name": "   "
      },
      "expectStatus": 400
    },
    {
      "name": "create-bad-types",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "body": {
        "name": 5,
        "enabled": "yes",
        "graph": [
          1
        ]
      },
      "expectStatus": 400
    },
    {
      "name": "create-minimal",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "body": {
        "name": " Minimal "
      },
      "capture": {
        "wfMin": "data.id"
      },
      "expectStatus": 201
    },
    {
      "name": "create-full",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "capture": {
        "wfFull": "data.id"
      },
      "rawBody": "{\"name\": \"Full\", \"enabled\": false, \"graph\": {\"boxes\": [{\"id\": \"t\", \"type\": \"trigger.manual\", \"config\": {}, \"x\": 10.5, \"y\": 2}, {\"id\": \"c\", \"type\": \"logic.condition\", \"config\": {\"match\": \"all\", \"rules\": [{\"field\": \"trigger.n\", \"op\": \"gt\", \"value\": \"1e1\"}]}}, {\"id\": \"h\", \"type\": \"action.http\", \"config\": {\"url\": \"https://example.com/hook\", \"apiKey\": \"sk-abcdefghijklmnop\", \"token\": \"\\u007b\\u007bsecret.TOKEN}}\", \"password\": \"hunter2\"}}], \"edges\": [{\"from\": \"t\", \"to\": \"c\"}, {\"from\": \"c\", \"fromPort\": \"true\", \"to\": \"h\"}], \"zoom\": 1.25}, \"extra\": \"ignored\"}",
      "headers": {
        "Content-Type": "application/json"
      },
      "expectStatus": 201
    },
    {
      "name": "create-null-graph",
      "method": "POST",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "body": {
        "name": "Nulls",
        "enabled": null,
        "graph": null
      },
      "capture": {
        "wfNull": "data.id"
      },
      "expectStatus": 201
    },
    {
      "name": "create-unknown-app",
      "method": "POST",
      "path": "/api/v1/apps/no-such-sf-app/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "body": {
        "name": "x"
      },
      "expectStatus": 404
    },
    {
      "name": "workflows-list",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows",
      "auth": "adminJwt",
      "expectStatus": 200
    },
