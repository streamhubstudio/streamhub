      "name": "workflow-get",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/{{wfFull}}",
      "auth": "adminJwt",
      "expectStatus": 200
    },
    {
      "name": "workflow-get-404",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/nope",
      "auth": "adminJwt",
      "expectStatus": 404
    },
    {
      "name": "workflow-export",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/{{wfFull}}/export",
      "auth": "adminJwt",
      "expectStatus": 200
    },
    {
      "name": "workflow-export-404",
      "method": "GET",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/nope/export",
      "auth": "adminJwt",
      "expectStatus": 404
    },
    {
      "name": "workflow-update",
      "method": "PUT",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/{{wfMin}}",
      "auth": "adminJwt",
      "body": {
        "name": "Renamed",
        "graph": {
          "edges": [],
          "boxes": [
            {
              "type": "trigger.event",
              "id": "e",
              "config": {
                "event": "plate.*"
              }
            }
          ]
        }
      },
      "expectStatus": 200
    },
    {
      "name": "workflow-update-nulls",
      "method": "PUT",
      "path": "/api/v1/apps/live/plugins/streamflow/workflows/{{wfNull}}",
      "auth": "adminJwt",
