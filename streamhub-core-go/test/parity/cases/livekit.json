      "name": "sign-ok",
      "method": "POST",
      "path": "/api/v1/apps/par-lk/play-token/demo/sign",
      "expectStatus": 201,
      "auth": "globalToken",
      "body": {
        "ttlSeconds": 120
      },
      "capture": {
        "lkSig": "data.sig",
        "lkExp": "data.exp"
      },
      "mask": [
        "data.exp",
        "data.tokenUrl",
        "data.playUrl",
        "data.embedUrl",
        "data.iframe"
      ]
    },
    {
      "name": "sign-default-ttl",
      "method": "POST",
      "path": "/api/v1/apps/par-lk/play-token/demo/sign",
      "expectStatus": 201,
      "auth": "globalToken",
      "rawBody": "",
      "mask": [
        "data.exp",
        "data.sig",
        "data.tokenUrl",
        "data.playUrl",
        "data.embedUrl",
        "data.iframe"
      ]
    },
    {
      "name": "play-token-private-signed",
      "method": "GET",
      "path": "/api/v1/apps/par-lk/play-token/demo?exp={{lkExp}}&sig={{lkSig}}",
      "expectStatus": 503,
      "note": "gate passes → mint fails on missing LiveKit creds"
    },
    {
      "name": "play-token-private-signed-uppercase",
