{
  "module": "livekit",
  "description": "LiveKit module (livekit.controller.ts, rooms.controller.ts, webhooks.controller.ts) + GET /stats. The parity env has empty LIVEKIT_* creds, so every SDK call fails identically (503 'LiveKit <op> failed: api-key and api-secret must be set'); cases cover validation 400s, RBAC denials, feature gates, the P0-3 signed-playback gate, the SSRF pull-URL guard and the webhook signature 401s. par-lk is created and deleted here.",
  "defaults": {
    "compareHeaders": [
      "content-type"
    ]
  },
  "cases": [
    {
      "name": "lk-setup-app",
      "method": "POST",
      "path": "/api/v1/apps",
      "expectStatus": 201,
      "auth": "globalToken",
      "body": {
        "name": "par-lk",
        "displayName": "LK"
      },
      "compare": "status",
      "note": "private-playback / adaptive / chat-off app for the gates below"
    },
    {
      "name": "lk-setup-config",
      "method": "PUT",
      "path": "/api/v1/apps/par-lk/config/raw",
      "expectStatus": 200,
      "auth": "globalToken",
      "body": {
        "yaml": "name: par-lk\nroom_prefix: lkp\ndisplay_name: LK\nwebrtc:\n  adaptive: true\n  transcode_max_height: 1080\n  layers:\n    - {name: low, height: 360}\n    - {name: high, height: 720}\nfeatures:\n  public_playback: false\n  chat: false\n  reactions: true\n  hidden_qc: false\n  adaptive_player: true\n  rtmp_password: true\n"
      },
      "compare": "status"
    },
    {
      "name": "tokens-no-auth",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 401,
      "body": {}
    },
    {
      "name": "tokens-viewer-denied",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 403,
      "auth": "viewerJwt",
      "body": {}
    },
    {
      "name": "tokens-owner-cross-tenant",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 403,
      "auth": "ownerJwt",
      "body": {}
    },
    {
      "name": "tokens-validation",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 400,
      "auth": "globalToken",
      "body": {
        "room": "bad room!",
        "identity": 5,
        "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "canPublish": "yes",
        "canSubscribe": 1,
        "ttl": "yyyyyyyyyyyyyyyyyyyyy",
        "metadata": 7,
        "hidden": "no",
        "recorder": 0,
        "audioOnly": "t"
      }
    },
    {
      "name": "tokens-room-pattern",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 400,
      "auth": "globalToken",
      "body": {
        "room": "a/b"
      }
    },
    {
      "name": "tokens-no-livekit-creds",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 503,
      "auth": "globalToken",
      "body": {
        "room": "demo",
        "identity": "u1"
      },
      "note": "empty LIVEKIT_API_KEY/SECRET → 503 before minting"
    },
    {
      "name": "tokens-app-token",
      "method": "POST",
      "path": "/api/v1/apps/live/tokens",
      "expectStatus": 503,
