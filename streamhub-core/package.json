{
  "name": "streamhub-core",
  "version": "0.1.0",
  "description": "StreamHub core — management layer over LiveKit (NestJS)",
  "author": "digitalhub",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "pretest": "if [ -n \"$STREAMHUB_APPS_TOKEN\" ]; then node ../scripts/apps-pull.mjs; else echo 'apps-pull skipped (no STREAMHUB_APPS_TOKEN): decoupled apps (lpr) not composed; their specs will skip'; fi",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --testRegex \\.e2e-spec\\.ts$",
    "export:openapi": "npm run build && node scripts/export-openapi.js",
    "build:examples": "npm run build && node ../scripts/build-examples.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "better-sqlite3": "^12.2.0",
    "bullmq": "^5.13.0",
    "casbin": "^5.51.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "livekit-server-sdk": "^2.7.0",
    "mqtt": "^5.15.1",
    "mysql2": "^3.22.6",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.22.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    }
  }
}
