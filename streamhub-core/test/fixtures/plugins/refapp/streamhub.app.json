{
  "manifestVersion": 1,
  "id": "refapp",
  "name": "Reference App (test fixture)",
  "description": "Test-only reference Studio App — never shipped.",
  "category": "processor",
  "ui": "app-tab",
  "version": "1.0.0",
  "kind": "app",
  "storage": { "db": "refapp.db" },
  "events": ["refapp.detected"],
  "configSchema": [
    { "key": "room", "type": "string", "label": "Room / stream", "default": "", "required": true, "placeholder": "cam1", "help": "HLS room name to analyze." },
    { "key": "callbackUrl", "type": "string", "label": "Callback URL", "default": "", "placeholder": "https://example.com/hooks/refapp", "help": "A secret POST target — stripped from the public config." },
    { "key": "confidence", "type": "number", "label": "Confidence", "default": 0.5, "min": 0, "max": 1 },
    { "key": "cuda", "type": "boolean", "label": "Use CUDA", "default": false }
  ],
  "worker": {
    "needsWorker": true,
    "entry": "{{pluginPython}} -m refapp_worker --app {{app}}",
    "workerDir": "worker",
    "cwd": "{{workerDir}}",
    "placement": "grid",
    "grid": { "gpu": true, "capabilities": ["cuda", "refapp"] },
    "edge": true,
    "env": {
      "PYTHONPATH": "{{workerDir}}",
      "PYTHONUNBUFFERED": "1",
      "REFAPP_APP": "{{app}}",
      "REFAPP_ROOM": "{{config.room}}",
      "REFAPP_DEVICE": "{{ config.cuda | ternary:cuda:cpu }}",
      "REFAPP_CONFIDENCE": "{{config.confidence}}",
      "REFAPP_CALLBACK_URL": "{{config.callbackUrl}}",
      "REFAPP_HLS_DIR": "{{appDir}}/hls",
      "REFAPP_LIVEKIT_URL": "{{livekitUrl}}"
    }
  }
}
