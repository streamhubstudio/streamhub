{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamhub.studio/schemas/streamhub.app.schema.json",
  "title": "StreamHub App Manifest",
  "description": "The declarative package descriptor (`streamhub.app.json`) a decoupled StreamHub Studio App ships instead of a plugin.meta.ts. It carries everything the core needs to register and run the app WITHOUT executing any JavaScript the package brought: identity, the typed config schema, declared events, and a pure spawn TEMPLATE for the worker. See https://streamhub.studio/docs/development/EXTENDING-STUDIO-APPS and internal design notes §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "category", "ui", "version", "configSchema"],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version. Currently always 1."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable slug. MUST equal the vendor folder name once composed in."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["tool", "processor", "panel"],
      "description": "Marketplace grouping."
    },
    "ui": {
      "type": "string",
      "enum": ["app-tab", "panel", "player-overlay", "player"],
      "description": "Where the app's UI renders."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$",
      "description": "Semver."
    },
    "kind": {
      "type": "string",
      "enum": ["plugin", "app"],
      "default": "app",
      "description": "'app' = full Studio App; 'plugin' = simple in-process extension."
    },
    "icon": { "type": "string" },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": { "type": "string", "description": "Core version range, e.g. '>=2.19 <3'." }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "db": {
          "type": "string",
          "pattern": "^[^/\\\\]+$",
          "description": "Bare SQLite filename the worker owns (no path separators, no '..')."
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Domain event names the worker may emit through the framework event channel."
    },
    "configSchema": {
      "type": "array",
      "description": "Typed config fields. Every field needs a default so a fresh install is valid.",
      "items": { "$ref": "#/$defs/configField" }
    },
    "worker": { "$ref": "#/$defs/worker" },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "description": "Package-relative frontend source dir (F0: verbatim TS)." },
        "dist": { "type": "string", "description": "Pre-built ESM entry (future composed/dist mode)." },
        "mode": { "type": "string", "enum": ["composed", "iframe"], "default": "composed" }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string", "description": "Package-relative dir of NNN_*.sql migration files." },
        "db": { "type": "string", "description": "The SQLite filename the migrations apply to." }
      }
    },
    "standalone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean" },
        "docs": { "type": "string" }
      }
    },
    "build": {
      "type": "object",
      "description": "Legacy monorepo glue (the retired in-tree apps-pack flow); STRIPPED from the published package by `streamhub-core apps pack`. Ignored by the core.",
      "additionalProperties": false,
      "properties": {
        "workerSrc": { "type": "string", "description": "In-tree worker package dir → packed as worker/**." },
        "workerSdk": { "type": "string", "description": "Shared Python SDK package dir → vendored INTO the worker (worker/<name>/**) so it is self-contained." },
        "frontendSrc": { "type": "string", "description": "In-tree web plugin source dir → packed as frontend/** (optional)." },
        "migrationsSrc": { "type": "string", "description": "In-tree migrations dir → packed as migrations/** (optional; migrations may also live inside worker/)." }
      }
    }
  },
  "$defs": {
    "configField": {
      "type": "object",
      "additionalProperties": true,
      "required": ["key", "type", "label", "default"],
      "properties": {
        "key": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "number", "boolean", "select", "secret"] },
        "label": { "type": "string" },
        "default": { "type": ["string", "number", "boolean", "null"] },
        "required": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "help": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } }
        }
      ]
    },
    "worker": {
      "type": "object",
      "description": "Declarative worker. `entry` (or command/args) plus `env` are TEMPLATES the core-owned interpreter renders — never eval'd. See the placeholder grammar in EXTENDING-STUDIO-APPS.md.",
      "additionalProperties": false,
      "properties": {
        "needsWorker": { "type": "boolean" },
        "entry": {
          "type": "string",
          "description": "Command line as one string, whitespace-tokenized into [command, ...args] BEFORE placeholder substitution (a substituted value can never inject an extra arg)."
        },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "default": "{{workerDir}}" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Env var name → template string."
        },
        "workerDir": {
          "type": "string",
          "description": "Worker source dir. Package-relative (default 'worker'); required for a composed package — apps pull keeps it relative and copies the worker alongside the manifest."
        },
        "requirements": { "type": "string" },
        "placement": { "type": "string", "enum": ["local", "grid"] },
        "edge": { "type": "boolean" },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gpu": { "type": "boolean" },
            "minVramGb": { "type": "number", "minimum": 0 },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "regions": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "needsWorker": { "const": true } } },
          "then": {
            "anyOf": [
              { "required": ["entry"] },
              { "required": ["command"] }
            ]
          }
        },
        {
          "if": { "required": ["grid"] },
          "then": { "properties": { "placement": { "const": "grid" } }, "required": ["placement"] }
        }
      ]
    }
  }
}
