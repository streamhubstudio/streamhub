{
  "manifestVersion": 1,
  "id": "crowd",
  "name": "Crowd — Density Threshold",
  "description": "Periodic head-count per polygon zone with a multi-cycle threshold alert — co-located or distributed per-stream on edge nodes.",
  "category": "processor",
  "ui": "app-tab",
  "version": "0.1.2",
  "kind": "app",
  "icon": "eye",
  "compat": {
    "core": ">=2.23 <3"
  },
  "storage": {
    "db": "crowd.db"
  },
  "export": {
    "workerDir": "vision-edge-runtime"
  },
  "events": [
    "crowd.count",
    "crowd.threshold"
  ],
  "configSchema": [
    {
      "key": "device",
      "type": "select",
      "label": "Inference device",
      "default": "cpu",
      "options": [
        {
          "value": "cpu",
          "label": "CPU (portable)"
        },
        {
          "value": "cuda",
          "label": "CUDA GPU (recommended for multi-stream)"
        }
      ],
      "help": "Where the model runs. Edge nodes advertise their own GPU capacity."
    },
    {
      "key": "fps",
      "type": "number",
      "label": "Sample FPS",
      "default": 3.5,
      "min": 0.5,
      "max": 30,
      "help": "Snapshot cadence for the head-count pipeline."
    },
    {
      "key": "confidence",
      "type": "number",
      "label": "Detection confidence",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "help": "Minimum detection confidence (0–1) applied when a zone does not override it."
    }
  ],
  "worker": {
    "needsWorker": true,
    "entry": "{{pluginPython}} -m vision_edge --model crowd",
    "workerDir": "worker",
    "cwd": "{{workerDir}}",
    "edge": true,
    "requirements": "worker/requirements.txt",
    "env": {
      "PYTHONPATH": "{{workerDir}}",
      "PYTHONUNBUFFERED": "1",
      "VISION_APP": "{{app}}",
      "VISION_MODEL": "crowd",
      "VISION_MODE": "{{ originUrl | ternary:edge:worker-manager }}",
      "VISION_DEVICE": "{{ config.device | map:cuda=cuda,*=cpu }}",
      "VISION_FPS": "{{ config.fps ?? '3.5' }}",
      "VISION_CONFIDENCE": "{{ config.confidence ?? '0.35' }}",
      "VISION_MODEL_DIR": "{{dataDir}}/models/vision",
      "VISION_ROOM": "{{config.room}}",
      "VISION_PUBLIC_BASE": "{{ originUrl ?? publicBase }}",
      "VISION_HLS_DIR": "{{appDir}}/hls",
      "VISION_LIVEKIT_URL": "{{livekitUrl}}",
      "VISION_DATA_DIR": "{{appDir}}/crowd",
      "VISION_CONFIG_JSON": "{{config.settings}}"
    }
  },
  "frontend": {
    "dir": "frontend",
    "mode": "composed"
  },
  "standalone": {
    "supported": true
  }
}
