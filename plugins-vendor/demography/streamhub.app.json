{
  "manifestVersion": 1,
  "id": "demography",
  "name": "Demography — Age / Gender / Emotion",
  "description": "Per-face age / gender / emotion reads (InsightFace, or an opt-in vision-API engine) — co-located or distributed per-stream on edge nodes.",
  "category": "processor",
  "ui": "app-tab",
  "version": "0.1.2",
  "kind": "app",
  "icon": "eye",
  "compat": {
    "core": ">=2.23 <3"
  },
  "storage": {
    "db": "demography.db"
  },
  "export": {
    "workerDir": "vision-edge-runtime"
  },
  "events": [
    "demography.face"
  ],
  "configSchema": [
    {
      "key": "device",
      "type": "select",
      "label": "Inference device",
      "default": "cpu",
      "options": [
        {
          "value": "cpu",
          "label": "CPU (portable)"
        },
        {
          "value": "cuda",
          "label": "CUDA GPU (recommended for multi-stream)"
        }
      ],
      "help": "Where the model runs. Edge nodes advertise their own GPU capacity."
    },
    {
      "key": "engine",
      "type": "select",
      "label": "Demography engine",
      "default": "local",
      "options": [
        {
          "value": "local",
          "label": "Local InsightFace (open-source, default)"
        },
        {
          "value": "openai",
          "label": "OpenAI vision API (opt-in, per-snapshot)"
        },
        {
          "value": "deepseek",
          "label": "DeepSeek vision API (opt-in, per-snapshot)"
        }
      ],
      "help": "Local by default. An API engine sends periodic snapshots to that provider."
    },
    {
      "key": "ai_api_key",
      "type": "secret",
      "label": "Vision-API key (openai / deepseek engines)",
      "default": "",
      "help": "Only used when the engine is an external API. Never sent to edge nodes in an assignment frame."
    },
    {
      "key": "fps",
      "type": "number",
      "label": "Sample FPS",
      "default": 3.5,
      "min": 0.5,
      "max": 30,
      "help": "Snapshot cadence for the demography pipeline."
    },
    {
      "key": "confidence",
      "type": "number",
      "label": "Detection confidence",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "help": "Minimum face-detection confidence (0–1)."
    }
  ],
  "worker": {
    "needsWorker": true,
    "entry": "{{pluginPython}} -m vision_edge --model demography",
    "workerDir": "worker",
    "cwd": "{{workerDir}}",
    "edge": true,
    "requirements": "worker/requirements.txt",
    "env": {
      "PYTHONPATH": "{{workerDir}}",
      "PYTHONUNBUFFERED": "1",
      "VISION_APP": "{{app}}",
      "VISION_MODEL": "demography",
      "VISION_MODE": "{{ originUrl | ternary:edge:worker-manager }}",
      "VISION_DEVICE": "{{ config.device | map:cuda=cuda,*=cpu }}",
      "VISION_FPS": "{{ config.fps ?? '3.5' }}",
      "VISION_CONFIDENCE": "{{ config.confidence ?? '0.35' }}",
      "VISION_MODEL_DIR": "{{dataDir}}/models/vision",
      "VISION_ROOM": "{{config.room}}",
      "VISION_PUBLIC_BASE": "{{ originUrl ?? publicBase }}",
      "VISION_HLS_DIR": "{{appDir}}/hls",
      "VISION_LIVEKIT_URL": "{{livekitUrl}}",
      "VISION_DATA_DIR": "{{appDir}}/demography",
      "VISION_CONFIG_JSON": "{{config.settings}}",
      "VISION_ENGINE": "{{ config.engine ?? 'local' }}",
      "VISION_AI_API_KEY": "{{ config.ai_api_key | localOnly }}"
    }
  },
  "frontend": {
    "dir": "frontend",
    "mode": "composed"
  },
  "standalone": {
    "supported": true
  }
}
